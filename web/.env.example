# Supabase (URL must be https://<project-ref>.supabase.co — not the env var name)
NEXT_PUBLIC_SUPABASE_URL=
# Prefer legacy anon JWT for browser Auth (avoids "Load Failed" with some sb_publishable setups)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional newer publishable key (used only if ANON is unset)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe (optional for pilot — demo shops skip billing gates)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Resend (transactional email)
# Add + verify domain `mail.tiktokshopguard.com` in Resend, then use:
RESEND_API_KEY=
RESEND_FROM_EMAIL=support@mail.tiktokshopguard.com
